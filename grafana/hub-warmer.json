{
 "uid": "hub-warmer",
 "title": "Hub Warmer",
 "tags": [
  "plex"
 ],
 "schemaVersion": 39,
 "editable": true,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "label": "Prometheus",
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Row loads under 1 s (24 h)",
   "description": "Share of real users' Home/library row loads that finished within 1 s (from the Plex request log).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(hub_warmer_user_row_load_seconds_bucket{le=\"1\"}[24h])) / sum(increase(hub_warmer_user_row_load_seconds_count[24h]))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.6
       },
       {
        "color": "green",
        "value": 0.85
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Row building done in advance (24 h)",
   "description": "Seconds Plex spent rebuilding rows while the warmer replayed them - time users would otherwise have waited.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(hub_warmer_cold_seconds_total[24h]))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Real loads served from cache",
   "description": "Share of real users' row requests answered entirely from Plex's cache (from the Plex log).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(hub_warmer_user_row_cache_hits_total[$__range])) / sum(increase(hub_warmer_user_row_cache_requests_total[$__range]))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.6
       },
       {
        "color": "green",
        "value": 0.85
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Requests kept warm",
   "description": "Distinct app requests being kept warm, across all accounts.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(hub_warmer_learned_requests)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Real row load time",
   "description": "How long real people waited for Home/library rows (1 h windows).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(hub_warmer_user_row_load_seconds_bucket[1h])))",
     "legendFormat": "median",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(hub_warmer_user_row_load_seconds_bucket[1h])))",
     "legendFormat": "95th percentile",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Share of row loads under 1 s",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(hub_warmer_user_row_load_seconds_bucket{le=\"1\"}[1h])) / sum(rate(hub_warmer_user_row_load_seconds_count[1h]))",
     "legendFormat": "under 1 s",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "sum(rate(hub_warmer_user_row_load_seconds_bucket{le=\"0.25\"}[1h])) / sum(rate(hub_warmer_user_row_load_seconds_count[1h]))",
     "legendFormat": "under 0.25 s",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     },
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Warming work",
   "description": "Cold = Plex had dropped that row (new download, collection sync, someone's playback) and rebuilt it during warming.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(hub_warmer_requests_total[$__rate_interval]))",
     "legendFormat": "requests replayed",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "sum(increase(hub_warmer_cold_requests_total[$__rate_interval]))",
     "legendFormat": "were cold (rebuilt ahead of users)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Plex cache & probe",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(hub_warmer_plex_hubcache_hit_ratio)",
     "legendFormat": "Plex hit ratio (incl. warmer)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "max(hub_warmer_probe_seconds)",
     "legendFormat": "probe seconds",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "Z",
     "expr": "sum(increase(hub_warmer_user_row_cache_hits_total[1h])) / sum(increase(hub_warmer_user_row_cache_requests_total[1h]))",
     "legendFormat": "Real users",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 9,
   "type": "stat",
   "title": "Warmer up",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 4,
    "h": 3
   },
   "targets": [
    {
     "refId": "A",
     "expr": "min(hub_warmer_up)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "NO"
        },
        "1": {
         "text": "OK"
        }
       }
      }
     ]
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "stat",
   "title": "Plex debug logging",
   "description": "Must be 1: the warmer learns apps from Plex debug log lines.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 4,
    "y": 20,
    "w": 4,
    "h": 3
   },
   "targets": [
    {
     "refId": "A",
     "expr": "min(hub_warmer_debug_logging_ok)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "NO"
        },
        "1": {
         "text": "OK"
        }
       }
      }
     ]
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "stat",
   "title": "Accounts",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 8,
    "y": 20,
    "w": 4,
    "h": 3
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(hub_warmer_accounts)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 12,
   "type": "stat",
   "title": "Last full warm",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 6,
    "h": 3
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - max(hub_warmer_last_warm_timestamp_seconds)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 13,
   "type": "stat",
   "title": "Errors (24 h)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 18,
    "y": 20,
    "w": 6,
    "h": 3
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(hub_warmer_errors_total[24h]))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 14,
   "type": "stat",
   "title": "Served from cache, without own playback (24 h)",
   "description": "Real loads served from cache, leaving out loads made while the account's own playback was dropping its rows. No warming can keep those cached.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(hub_warmer_user_row_cache_hits_total[24h])) / (sum(increase(hub_warmer_user_row_cache_requests_total[24h])) - sum(increase(hub_warmer_user_row_misses_total{cause=\"own playback\"}[24h])))",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 0,
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   }
  },
  {
   "id": 15,
   "type": "stat",
   "title": "Plex notification feed",
   "description": "Whether the warmer is connected to Plex's notification feed, which reports library changes and stopped playback.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 6,
    "y": 23,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "min(hub_warmer_library_events_connected)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Not connected",
         "color": "red"
        },
        "1": {
         "text": "Connected",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   }
  },
  {
   "id": 16,
   "type": "stat",
   "title": "Passes after library changes (24 h)",
   "description": "Passes started because Plex reported added, changed or removed items.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 23,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(hub_warmer_library_passes_total[24h]))",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   }
  },
  {
   "id": 17,
   "type": "stat",
   "title": "Collection passes after playback (24 h)",
   "description": "Short passes over Home and library pages started because someone stopped playing something, which drops every account's collection rows.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 18,
    "y": 23,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(hub_warmer_playback_passes_total[24h]))",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   }
  },
  {
   "id": 18,
   "type": "timeseries",
   "title": "Slow loads by cause",
   "description": "Real row loads slower than the slow-load threshold, per hour, by what dropped the rows.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "interval": "1h",
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (cause) (increase(hub_warmer_user_slow_loads_total[$__interval]))",
     "legendFormat": "{{cause}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal",
       "group": "A"
